{
  "name": "usite",
  "version": "3.0.0",
  "description": "Tiny static site generator",
  "license": "MIT",
  "author": "Tomas Grubliauskas",
  "type": "module",
  "repository": "git://github.com/v3nom/uSite.git",
  "bugs": {
    "url": "http://github.com/v3nom/uSite/issues"
  },
  "main": "dist/usite.js",
  "bin": {
    "uSite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "fs-extra": "11.4.1",
    "glob": "14.0.6",
    "highlight.js": "11.12.0",
    "js-yaml": "5.5.0",
    "marked": "18.2.0",
    "marked-highlight": "2.2.4",
    "nunjucks": "3.2.4",
    "speakingurl": "14.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.6.6",
    "@types/nunjucks": "3.2.6",
    "@types/speakingurl": "13.0.6",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "keywords": [
    "static site generator",
    "static website generator",
    "web generator",
    "generator",
    "static website",
    "static",
    "blog",
    "website"
  ]
}
